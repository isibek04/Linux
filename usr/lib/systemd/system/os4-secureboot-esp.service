[Unit]
Description=Put shim in front of systemd-boot on the ESP
Documentation=file:///usr/libexec/os4-secureboot-esp
# A deployed bootc host, not this image running as a container. Either marker
# will do: the ostree backend creates /run/ostree-booted, the composefs backend
# does not, and its only trace is the digest karg on its cmdline. That karg
# has two spellings: `composefs=<hex>` for the V2 EROFS format, and
# `composefs.digest=v1-sha512-12:<hex>` for V1, which is what a bootc 1.17
# install defaults to. systemd matches the key whole, so each needs its own
# line. The `|` makes these alternatives; the EFI condition below still applies.
ConditionPathExists=|/run/ostree-booted
ConditionKernelCommandLine=|composefs
ConditionKernelCommandLine=|composefs.digest
# Nothing to do where there is no ESP to fix. The image installs no BIOS
# bootloader, so a machine without this is not booting from this disk anyway.
ConditionPathExists=/sys/firmware/efi
# The script finds the ESP by partition type and mounts it itself, but it still
# needs the block devices to have been probed.
After=local-fs.target

[Service]
Type=oneshot
# Runs on every boot rather than once. It is a no-op when the ESP is already
# right, and running it again is what repairs the chain if `bootctl install`
# ever puts the unshimmed systemd-boot back at EFI/BOOT/BOOTX64.EFI.
ExecStart=/usr/libexec/os4-secureboot-esp
# Nothing else is ordered after this, so a failure marks the unit failed and
# leaves the boot alone -- which is the right outcome: a machine whose ESP
# could not be fixed is a machine that boots with Secure Boot off, exactly
# where it started. `systemctl status os4-secureboot-esp` says why.

[Install]
WantedBy=multi-user.target
